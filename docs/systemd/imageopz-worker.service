[Unit]
Description=ImageOpz Worker (Queue + Cleanup)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/imageopz/imageopz-server
EnvironmentFile=/opt/imageopz/imageopz-server/.env
ExecStart=/opt/imageopz/venv/bin/python /opt/imageopz/imageopz-server/run_worker.py --with-scheduler
Restart=always
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/imageopz/imageopz-server

[Install]
WantedBy=multi-user.target

