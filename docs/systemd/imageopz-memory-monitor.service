[Unit]
Description=ImageOpz Memory Monitor
After=network.target
Requires=imageopz-api.service

[Service]
Type=simple
User=imageopz
WorkingDirectory=/path/to/imageopz-server
ExecStart=/usr/bin/python3 monitor_memory.py --interval 2
Restart=always
RestartSec=10
StandardOutput=append:/path/to/imageopz-server/logs/memory_monitor.log
StandardError=append:/path/to/imageopz-server/logs/memory_monitor.log

[Install]
WantedBy=multi-user.target