[Unit]
Description=ImageOpz API (FastAPI)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/imageopz/imageopz-server
EnvironmentFile=/opt/imageopz/imageopz-server/.env
ExecStart=/opt/imageopz/venv/bin/python /opt/imageopz/imageopz-server/run.py --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=2

# Hardening (safe defaults; adjust paths as needed)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/imageopz/imageopz-server

[Install]
WantedBy=multi-user.target

