# Non-secret parameters for deploy/gcloud/*.sh. Copy per environment outside the repo (e.g. ~/imageopz-staging.env),
# fill in, then: set -a; . ~/imageopz-staging.env; set +a; ./NN-*.sh
# NO SECRETS HERE. Secret values go only to Secret Manager: gcloud secrets versions add NAME --data-file=-
PROJECT_ID='imageopz-prod-4821'
REGION='asia-northeast1'
ENV='staging'                 # staging | prod
DRY_RUN='1'                   # 0 executes
PROJECT_NUMBER=''             # optional; read from `gcloud projects describe` when DRY_RUN=0

# Images, pinned by digest (CI prints them in the deploy run summary; 50/60/ci-rollout)
API_IMAGE='asia-northeast1-docker.pkg.dev/imageopz-prod-4821/imageopz/api@sha256:<digest>'
PAYMENTS_IMAGE='asia-northeast1-docker.pkg.dev/imageopz-prod-4821/imageopz/payments-ingress@sha256:<digest>'

# Browser origins allowed by the API (comma-separated, no wildcard; DEPLOY-PLAN.md "Networking")
UI_ORIGINS='https://staging.imageopz.aindrajaya.my.id'   # Q3; prod: https://imageopz.aindrajaya.my.id

# Cloudflare R2 (account id and bucket names are not secrets). The staging buckets and their scoped tokens are created
# by the owner in Cloudflare, not by these scripts (DEPLOY-PLAN.md section 5, Q4; README "Owner steps outside gcloud").
R2_ACCOUNT_ID=''
R2_BUCKET_NAME='imageopz-staging'            # prod: imageopz
R2_CUSTOM_DOMAIN='https://<outputs-domain>'
R2_UPLOADS_BUCKET='imageopz-uploads-staging' # prod: imageopz-uploads

# Supabase project of this environment (URL and publishable anon key are public by design)
SUPABASE_URL='https://<project-ref>.supabase.co'
SUPABASE_ANON_KEY=''

# LemonSqueezy checkout (store/variant ids are public; staging uses a test-mode store)
LEMONSQUEEZY_STORE_ID=''
LEMONSQUEEZY_VARIANT_ID=''
LEMONSQUEEZY_REDIRECT_URL=''

# 50-jobs.sh: execute the migrate job after deploying it
EXECUTE_MIGRATE='0'

# 70-scheduler.sh (worker maintenance endpoints, request-based billing; Q1, U2)
SWEEP_SCHEDULE='*/5 * * * *'
CLEANUP_SCHEDULE='17 * * * *'
PAUSE=''                      # default: 1 for staging, 0 for prod

# 80-wif.sh (gh api repos/aindrajaya/imageopz-server --jq '.id, .owner.id')
GITHUB_REPOSITORY_ID=''
GITHUB_OWNER_ID=''
DEPLOY_WORKFLOW='aindrajaya/imageopz-server/.github/workflows/deploy.yml@refs/heads/main'  # pinned in the WIF condition

# 90-observability.sh
NOTIFICATION_CHANNEL=''       # projects/<project>/notificationChannels/<id> (email channel, console)
BILLING_ACCOUNT=''            # once, for the project budget
BUDGET_AMOUNT='10USD'

# 10-artifact-registry.sh: 0 switches the cleanup policy from dry-run to deleting
CLEANUP_DRY_RUN='1'
