# FastAPI Settings
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
PROXY_HEADERS=True

# CORS (comma-separated)
# Example: CORS_ALLOW_ORIGINS=https://imageopz.com,https://www.imageopz.com
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://imageopz.aindrajaya.my.id
# Only enable if you need cookies/Authorization from browsers
CORS_ALLOW_CREDENTIALS=False

# Database
DATABASE_URL=sqlite:///./imageopz.db
DATABASE_ECHO=False

# Redis & Job Queue
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
QUEUE_NAME=imageopz_jobs

# JWT & Security
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=imageopz
R2_CUSTOM_DOMAIN=https://your-domain.r2.dev

# LemonSqueezy Webhook
LEMONSQUEEZY_SECRET=your-webhook-secret
LEMONSQUEEZY_API_KEY=your-api-key
# LemonSqueezy Checkout (server-side)
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
# Optional: override redirect after successful payment
LEMONSQUEEZY_REDIRECT_URL=
# Optional: set true for test checkouts
LEMONSQUEEZY_TEST_MODE=False

# Resend Email (Fallback Notifications)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="ImageOpz <noreply@imageopz.com>"

# Image Processing
MIN_IMAGE_SIZE=1048576  # 1MB in bytes
FREE_TIER_QUALITY=50
PRO_TIER_QUALITY=75
AVIF_COMPRESSION_SPEED=6
MAX_IMAGE_PIXELS=250000000  # 250MP - OOM protection

# Quotas
FREE_TIER_MAX_CREDITS=3
FREE_TIER_MAX_FILE_SIZE=10485760  # 10MB
FREE_TIER_MAX_BULK_IMAGES=3
PRO_TIER_MAX_FILE_SIZE=52428800  # 50MB
PRO_TIER_MAX_BULK_IMAGES=30

# File Expiry (days)
FREE_TIER_EXPIRY_DAYS=7
PRO_TIER_EXPIRY_DAYS=40

# Cleanup Job
CLEANUP_CRON_SCHEDULE=0 0 * * *  # Daily at midnight

# Environment
ENVIRONMENT=development

# Session cookie
SESSION_COOKIE_NAME=imageopz_sid
SESSION_COOKIE_MAX_AGE_DAYS=365

1_SampeK_8
